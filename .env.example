# Copy to .env and fill in. Never commit the real .env.

# Ollama Cloud (only needed if llm.ollama.host points at https://ollama.com)
OLLAMA_API_KEY=

# Anthropic (only needed if llm.provider: anthropic)
ANTHROPIC_API_KEY=

# Spotify Web API (only needed if music.provider: spotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional cloud weather API key used by plugins/weather (open-meteo needs none by default)
WEATHER_API_KEY=
